# .mdspecmap — mdspec configuration file
# Project: Test for mdspecs
#
# Edit this file to configure folder-to-integration mappings.
# Define aliases in Dashboard → Map → Aliases.
#
# Docs: https://mdspec.dev/docs/mdspecmap

version: 1

sync_all_on_first_run: true

mappings:
  - integration: clickup
    target: task
    list_id: id:901817533430
    space_id: id:folder:901813560821
    agent: Task Template - 1
